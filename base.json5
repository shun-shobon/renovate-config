// 基本設定
{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: [
		// 推奨設定
		"config:best-practices",

		// タイムゾーンを日本に設定
		":timezone(Asia/Tokyo)",

		// semantic commits を使用
		":semanticCommits",

		// マイナーバージョンアップデートまでは自動マージを使用
		":automergeMinor",

		// 毎日更新を行う
		"schedule:daily",

		// PRの作成数の制限を無効化
		":disableRateLimiting",
	],
	// バージョンアップデートはbumpを使用
	// https://docs.renovatebot.com/configuration-options/#rangestrategy
	rangeStrategy: "bump",

	// config:best-practices に含まれる :maintainLockFilesWeekly を打ち消す
	lockFileMaintenance: { enabled: false },
}
