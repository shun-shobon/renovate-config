{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: [
		// Unpublishされる可能性がある間は更新しない
		"security:minimumReleaseAgeNpm",
	],
	packageRules: [
		// peer depsの更新はbumpではなくwidenで行う
		{
			matchManagers: ["npm"],
			extends: [":widenPeerDependencies"],
		},

		// lockFileMaintenanceを無効にしているため、更新の度に重複を解消する
		{
			matchManagers: ["npm"],
			postUpdateOptions: ["pnpmDedupe"],
		},

		// @iconify-jsonのアイコンセットは同じ日に更新されやすいため、1つのPRにまとめる
		{
			matchManagers: ["npm"],
			matchPackageNames: ["@iconify-json/*"],
			groupName: "iconify-json",
		},

		// 自分のlint・formatの設定はすぐに更新する
		{
			matchManagers: ["npm"],
			matchPackageNames: ["@shun-shobon/oxlint-config", "@shun-shobon/oxfmt-config"],
			minimumReleaseAge: null,
			schedule: ["at any time"],
		},
	],
}
